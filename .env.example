# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# ADVERTENCIA DE SEGURIDAD:
# NUNCA agregues valores reales ni contraseñas a este archivo.
# Copia este archivo como '.env' en tu entorno local y completa los valores allí.
# '.env' está ignorado en Git para prevenir fugas accidentales de secretos.
# ==============================================================================

# Credenciales de EmailJS (Servicio de envío de correo en cliente)
# Nota: En Astro, las variables que inician con PUBLIC_ son accesibles en el navegador.
# NUNCA coloques tokens con permisos administrativos ni contraseñas de BD bajo PUBLIC_.
PUBLIC_EMAILJS_PUBLIC_KEY=tu_public_key_aqui
PUBLIC_EMAILJS_SERVICE_ID=tu_service_id_aqui
PUBLIC_EMAILJS_TEMPLATE_ID=tu_template_id_aqui

# URL canónica del sitio (para SEO y validación de seguridad de orígenes)
PUBLIC_SITE_URL=https://jorgegamez.vercel.app
