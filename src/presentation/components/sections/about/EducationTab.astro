---
/**
 * @file EducationTab.astro
 * @description Pestaña de educación formal, posgrados y certificaciones.
 * Capa: Presentation / Components / Sections / About
 */

import { educationData } from '../../../../infrastructure/data/education.data';
---

<div class="about-detail education" id="tab-education" role="tabpanel">
  <h2 class="heading">Mi <span>Educación</span></h2>
  <div class="about-list">
    {
      educationData.map((item) => (
        <div class="about-item">
          <p class="year">{item.period}</p>
          <h3>{item.degree}</h3>
          <p class="company">{item.institution}</p>
        </div>
      ))
    }
  </div>
</div>
