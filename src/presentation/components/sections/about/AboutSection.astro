---
/**
 * @file AboutSection.astro
 * @description Sección "Sobre mí" que orquesta las pestañas de Experiencia, Educación, Habilidades y Datos Personales.
 * Capa: Presentation / Components / Sections / About
 */

import ExperienceTab from './ExperienceTab.astro';
import EducationTab from './EducationTab.astro';
import SkillsTab from './SkillsTab.astro';
import AboutMeTab from './AboutMeTab.astro';
---

<section class="about" id="about" data-section-index="1">
  <div class="about-container">
    <div class="about-box">
      <h2>¿Por qué trabajar juntos?</h2>
      <p class="desc">
        Porque combino experiencia técnica sólida con capacidad de resolver problemas reales de negocio.
      </p>
      <button class="about-btn active" data-tab="0" type="button">Experiencia</button>
      <button class="about-btn" data-tab="1" type="button">Educación</button>
      <button class="about-btn" data-tab="2" type="button">Habilidades</button>
      <button class="about-btn" data-tab="3" type="button">Sobre mí</button>
    </div>

    <div class="about-box">
      <ExperienceTab />
      <EducationTab />
      <SkillsTab />
      <AboutMeTab />
    </div>
  </div>
</section>
